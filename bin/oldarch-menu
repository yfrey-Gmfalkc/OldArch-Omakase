#!/usr/bin/env bash
set -euo pipefail

# OldArch-Omakase menu (simple TUI)
# This is intentionally minimal and dependency-light.

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

banner() {
  clear || true
  echo "OldArch-Omakase menu"
  echo "===================="
  echo
}

pause() {
  echo
  read -r -p "Press Enter to continue..." _
}

run_step() {
  local step="$1"
  bash "${ROOT_DIR}/scripts/${step}"
}

apply_theme() {
  local theme="$1"
  mkdir -p "${HOME}/.config/oldarch/themes"

  # Xresources for xterm (lightweight)
  case "$theme" in
    matrix)
      cat >"${HOME}/.Xresources" <<'EOF'
! OldArch-Omakase - Matrix
XTerm*faceName: DejaVu Sans Mono
XTerm*faceSize: 10
XTerm*background: #000000
XTerm*foreground: #00ff00
XTerm*cursorColor: #00ff00
EOF
      ;;
    gruvbox)
      cat >"${HOME}/.Xresources" <<'EOF'
! OldArch-Omakase - Gruvbox
XTerm*faceName: DejaVu Sans Mono
XTerm*faceSize: 10
XTerm*background: #282828
XTerm*foreground: #ebdbb2
XTerm*cursorColor: #ebdbb2
EOF
      ;;
    nord)
      cat >"${HOME}/.Xresources" <<'EOF'
! OldArch-Omakase - Nord
XTerm*faceName: DejaVu Sans Mono
XTerm*faceSize: 10
XTerm*background: #2E3440
XTerm*foreground: #D8DEE9
XTerm*cursorColor: #D8DEE9
EOF
      ;;
    catppuccin)
      cat >"${HOME}/.Xresources" <<'EOF'
! OldArch-Omakase - Catppuccin-ish
XTerm*faceName: DejaVu Sans Mono
XTerm*faceSize: 10
XTerm*background: #1E1E2E
XTerm*foreground: #CDD6F4
XTerm*cursorColor: #CDD6F4
EOF
      ;;
    *)
      echo "Unknown theme: $theme" >&2
      return 1
      ;;
  esac

  # i3 basic colors (very lightweight)
  mkdir -p "${HOME}/.config/i3"
  if [[ -f "${HOME}/.config/i3/config" ]]; then
    # keep user config, only append theme include if not present
    if ! grep -q "# OldArch theme include" "${HOME}/.config/i3/config"; then
      cat >>"${HOME}/.config/i3/config" <<'EOF'

# OldArch theme include
# (generated by oldarch-menu)
include ~/.config/oldarch/i3-theme.conf
EOF
    fi
  fi

  mkdir -p "${HOME}/.config/oldarch"
  case "$theme" in
    matrix)
      cat >"${HOME}/.config/oldarch/i3-theme.conf" <<'EOF'
# Matrix
client.focused          #00ff00 #00ff00 #000000 #00ff00 #00ff00
client.unfocused        #111111 #111111 #00ff00 #111111 #111111
bar {
  colors {
    background #000000
    statusline #00ff00
    focused_workspace  #00ff00 #00ff00 #000000
    inactive_workspace #111111 #111111 #00ff00
  }
}
EOF
      ;;
    gruvbox)
      cat >"${HOME}/.config/oldarch/i3-theme.conf" <<'EOF'
# Gruvbox
client.focused          #458588 #458588 #ebdbb2 #458588 #458588
client.unfocused        #3c3836 #3c3836 #ebdbb2 #3c3836 #3c3836
bar {
  colors {
    background #282828
    statusline #ebdbb2
    focused_workspace  #458588 #458588 #282828
    inactive_workspace #3c3836 #3c3836 #ebdbb2
  }
}
EOF
      ;;
    nord)
      cat >"${HOME}/.config/oldarch/i3-theme.conf" <<'EOF'
# Nord
client.focused          #88C0D0 #88C0D0 #2E3440 #88C0D0 #88C0D0
client.unfocused        #3B4252 #3B4252 #D8DEE9 #3B4252 #3B4252
bar {
  colors {
    background #2E3440
    statusline #D8DEE9
    focused_workspace  #88C0D0 #88C0D0 #2E3440
    inactive_workspace #3B4252 #3B4252 #D8DEE9
  }
}
EOF
      ;;
    catppuccin)
      cat >"${HOME}/.config/oldarch/i3-theme.conf" <<'EOF'
# Catppuccin-ish
client.focused          #89B4FA #89B4FA #1E1E2E #89B4FA #89B4FA
client.unfocused        #313244 #313244 #CDD6F4 #313244 #313244
bar {
  colors {
    background #1E1E2E
    statusline #CDD6F4
    focused_workspace  #89B4FA #89B4FA #1E1E2E
    inactive_workspace #313244 #313244 #CDD6F4
  }
}
EOF
      ;;
  esac

  xrdb -merge "${HOME}/.Xresources" || true
  i3-msg reload >/dev/null 2>&1 || true
  echo "Applied theme: $theme"
}

set_wallpaper() {
  local img="$1"
  if [[ ! -f "$img" ]]; then
    echo "File not found: $img" >&2
    return 1
  fi
  mkdir -p "${HOME}/.config/oldarch"
  cp -f "$img" "${HOME}/.config/oldarch/wallpaper" || true
  feh --no-fehbg --bg-fill "$img" || true
  echo "Wallpaper set."
}

main() {
  while true; do
    banner
    cat <<'EOF'
1) Run full bootstrap (all-in-one)
2) Apply theme: Matrix
3) Apply theme: Gruvbox
4) Apply theme: Nord
5) Apply theme: Catppuccin-ish
6) Set wallpaper (path)
7) Start X (startx)
8) Exit
EOF
    echo
    read -r -p "Select: " choice
    case "$choice" in
      1)
        bash "${ROOT_DIR}/bootstrap.sh" --profile all-in-one
        pause
        ;;
      2) apply_theme matrix; pause ;;
      3) apply_theme gruvbox; pause ;;
      4) apply_theme nord; pause ;;
      5) apply_theme catppuccin; pause ;;
      6)
        read -r -p "Wallpaper image path: " p
        set_wallpaper "$p"
        pause
        ;;
      7) startx ;;
      8) exit 0 ;;
      *) echo "Invalid option"; pause ;;
    esac
  done
}

main
